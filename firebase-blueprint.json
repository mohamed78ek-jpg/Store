{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Product sold in the store",
      "type": "object",
      "properties": {
        "id": { "type": "number" },
        "name": { "type": "string" },
        "price": { "type": "number" },
        "discountPrice": { "type": "number" },
        "category": { "type": "string" },
        "image": { "type": "string" },
        "description": { "type": "string" },
        "sizes": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["name", "price", "category", "image"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer order details",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "customerName": { "type": "string" },
        "phoneNumber": { "type": "string" },
        "email": { "type": "string" },
        "address": { "type": "string" },
        "items": { "type": "array" },
        "totalAmount": { "type": "number" },
        "date": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["pending", "processing", "shipped", "delivered", "cancelled"] },
        "userId": { "type": "string" }
      },
      "required": ["customerName", "phoneNumber", "address", "items", "totalAmount", "status"]
    },
    "Report": {
      "title": "Report",
      "description": "Problem report from user",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "contact": { "type": "string" },
        "message": { "type": "string" },
        "date": { "type": "string", "format": "date-time" },
        "isRead": { "type": "boolean" }
      },
      "required": ["name", "contact", "message", "date"]
    },
    "Settings": {
      "title": "Settings",
      "description": "Global app settings",
      "type": "object",
      "properties": {
        "bannerText": { "type": "string" },
        "popupConfig": {
          "type": "object",
          "properties": {
            "isActive": { "type": "boolean" },
            "image": { "type": "string" }
          }
        }
      }
    }
  },
  "firestore": {
    "/products/{productId}": { "schema": "Product", "description": "Collection of available products" },
    "/orders/{orderId}": { "schema": "Order", "description": "Collection of customer orders" },
    "/reports/{reportId}": { "schema": "Report", "description": "Collection of user problem reports" },
    "/settings/global": { "schema": "Settings", "description": "Global settings for banner and popups" }
  }
}
