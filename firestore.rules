rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper to check if user is admin
    function isAdmin() {
      return request.auth != null && 
             (request.auth.token.email.lower() == 'mohamederrabani951@gmail.com' || 
              request.auth.token.email.lower() == 'mohamedrbani9@gmail.com');
    }

    // Products: Public read, Admin write
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Orders: Public create, Admin manage
    match /orders/{orderId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Reports: Public create, Admin manage
    match /reports/{reportId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Site Config: Public read, Admin write
    match /siteConfig/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
