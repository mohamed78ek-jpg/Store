rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Utilities ---
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    
    // Check if user is admin (email-based for simplicity in this template)
    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'mohamederrabani951@gmail.com';
    }

    // --- Collections ---

    // 1. Products: Publicly readable and writable (Simplified as requested)
    match /products/{productId} {
      allow read, write: if true;
    }

    // 2. Orders: Publicly readable and writable
    match /orders/{orderId} {
      allow read, write: if true;
    }

    // 3. Reports: Publicly readable and writable
    match /reports/{reportId} {
      allow read, write: if true;
    }

    // 4. Site Config: Publicly readable and writable
    match /siteConfig/global {
      allow read, write: if true;
    }
  }
}
