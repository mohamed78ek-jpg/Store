rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- 1. Global Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      // Admin check based on verified email
      return isSignedIn() && 
             request.auth.token.email == 'mohamederrabani951@gmail.com';
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // --- 2. Entity Validation Blueprints ---

    function isValidProduct(data) {
      return data.keys().hasAll(['id', 'name', 'price', 'image', 'category', 'description']) &&
             data.id is string && isValidId(data.id) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
             data.price is number && data.price >= 0 &&
             data.image is string && data.image.size() <= 1000000 && // Allowing for base64
             data.category is string &&
             data.description is string &&
             (!('discountPrice' in data) || (data.discountPrice is number && data.discountPrice >= 0)) &&
             (!('sizes' in data) || (data.sizes is list && data.sizes.size() <= 20));
    }

    function isValidOrder(data) {
      return data.keys().hasAll(['id', 'customerName', 'phoneNumber', 'email', 'address', 'items', 'totalAmount', 'date', 'status']) &&
             data.id is string && isValidId(data.id) &&
             data.customerName is string && data.customerName.size() <= 200 &&
             data.phoneNumber is string && data.phoneNumber.size() <= 50 &&
             data.email is string && data.email.size() <= 200 &&
             data.address is string && data.address.size() <= 500 &&
             data.items is list && data.items.size() > 0 && data.items.size() <= 100 &&
             data.totalAmount is number && data.totalAmount >= 0 &&
             data.status in ['pending', 'processing', 'shipped', 'delivered', 'cancelled'] &&
             data.date is string &&
             (!('receiptFile' in data) || (data.receiptFile is string));
    }

    function isValidReport(data) {
      return data.keys().hasAll(['id', 'name', 'contact', 'message', 'date', 'isRead']) &&
             data.id is string && isValidId(data.id) &&
             data.name is string && data.name.size() <= 200 &&
             data.contact is string && data.contact.size() <= 200 &&
             data.message is string && data.message.size() <= 2000 &&
             data.date is string &&
             data.isRead is bool;
    }

    // --- 3. Collection Rules ---

    // Products: Publicly readable, writeable only by verified admin
    match /products/{productId} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidProduct(incoming());
      allow delete: if isAdmin();
    }

    // Orders: Anyone can create an order, only admin can manage them
    match /orders/{orderId} {
      allow create: if isValidOrder(incoming());
      // Admin has full control
      allow read, update, delete: if isAdmin();
      // Allow individual order lookup if we had a tracking system based on ID 
      // (The app has TrackOrder component which might need this)
      allow get: if isValidId(orderId);
    }

    // Reports: Anyone can submit a report, only admin can view/manage
    match /reports/{reportId} {
      allow create: if isValidReport(incoming());
      allow read, update, delete: if isAdmin();
    }

    // Site Config: Publicly readable, admin-only updates
    match /siteConfig/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
