rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Utilities ---
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    
    // Check if user is admin (email-based for simplicity in this template)
    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'mohamederrabani951@gmail.com';
    }

    // --- Collections ---

    // 1. Products: Publicly readable, only admin can write
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin() && isValidId(productId);
    }

    // 2. Orders: Publicly creatable, admin can manage, owner can read if they have ID (in our case tracked by anonymous ID)
    match /orders/{orderId} {
      function isValidOrder(data) {
        return data.customerName is string && data.customerName.size() <= 100
            && data.customerPhone is string && data.customerPhone.size() <= 20
            && data.customerAddress is string && data.customerAddress.size() <= 200
            && data.total is number && data.total >= 0;
      }

      allow create: if isValidId(orderId) && isValidOrder(request.resource.data);
      allow read: if true; // In a real app we'd restrict, but for tracking by ID we allow read
      allow update, delete: if isAdmin();
    }

    // 3. Reports: Publicly creatable, only admin can read/manage
    match /reports/{reportId} {
      allow create: if isValidId(reportId) && request.resource.data.description is string;
      allow read, update, delete: if isAdmin();
    }

    // 4. Site Config: Publicly readable, only admin can write
    match /siteConfig/global {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
