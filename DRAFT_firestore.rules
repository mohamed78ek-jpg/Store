rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- 1. Global Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      // In a real app, use a dedicated 'admins' collection. 
      // For this template, we follow the user's previously defined logic or a simple email check.
      return isSignedIn() && request.auth.token.email == 'mohamederrabani951@gmail.com';
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // --- 2. Entity Validation Blueprints ---

    function isValidProduct(data) {
      return data.keys().hasAll(['id', 'name', 'price', 'image', 'category']) &&
             data.id is string && isValidId(data.id) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
             data.price is number && data.price >= 0 &&
             data.image is string && data.image.size() <= 1000 &&
             data.category is string &&
             (!('discountPrice' in data) || (data.discountPrice is number && data.discountPrice >= 0)) &&
             (!('sizes' in data) || (data.sizes is list && data.sizes.size() <= 20));
    }

    function isValidOrder(data) {
      return data.keys().hasAll(['id', 'customerName', 'customerPhone', 'customerAddress', 'items', 'total', 'status', 'createdAt']) &&
             data.id is string && isValidId(data.id) &&
             data.customerName is string && data.customerName.size() <= 200 &&
             data.customerPhone is string && data.customerPhone.size() <= 30 &&
             data.customerAddress is string && data.customerAddress.size() <= 500 &&
             data.items is list && data.items.size() > 0 && data.items.size() <= 100 &&
             data.total is number && data.total >= 0 &&
             data.status in ['pending', 'processing', 'shipped', 'delivered', 'cancelled'] &&
             data.createdAt is string; // In production prefer request.time
    }

    function isValidReport(data) {
      return data.keys().hasAll(['id', 'type', 'description', 'status', 'createdAt']) &&
             data.id is string && isValidId(data.id) &&
             data.type is string &&
             data.description is string && data.description.size() <= 2000 &&
             data.status is string &&
             data.createdAt is string;
    }

    // --- 3. Collection Rules ---

    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin() && isValidProduct(incoming());
    }

    match /orders/{orderId} {
      // Only admin can list/read all orders. 
      // Individual users don't have accounts in this app structure yet, so we allow creation.
      allow create: if isValidOrder(incoming());
      allow read, update, delete: if isAdmin();
    }

    match /reports/{reportId} {
      allow create: if isValidReport(incoming());
      allow read, update, delete: if isAdmin();
    }

    match /siteConfig/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
